# Copy to .env. Never commit .env.
# External model (only used by the "hybrid" / "eu-hosted" profiles; the default "no-egress" profile never reads it)
ANTHROPIC_API_KEY=
# Only when the key is an organisation-level key (the API then answers "not scoped to a workspace"):
# the id of the workspace to bill, from Claude Console > Settings > Workspaces (looks like wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
# Optional other endpoint for the hybrid profile's Anthropic client (e.g. Claude on Bedrock)
TPM_EXTERNAL_BASE_URL=
# eu-hosted profile: Mistral Large 3 on the hackathon's Verda GPU containers in Finland (endpoint and model are in
# config/settings.yaml, profiles.eu-hosted.external_llm). Only the key goes here, sent as a Bearer token.
TPM_EU_API_KEY=
# Optional: another EU-hosted service instead (its host must be on profiles.eu-hosted.eu_hosts)
# TPM_EU_BASE_URL=https://api.eu.mistral.ai/v1
# TPM_EU_MODEL=mistral-medium-latest
# TPM_EU_PROVIDER=openai-compatible
# Local model overrides
OLLAMA_HOST=http://localhost:11434
TPM_LOCAL_MODEL=gemma4:e4b-it-qat
# Profile override: no-egress | hybrid | eu-hosted
TPM_PROFILE=no-egress
# Report e-mail (optional). Any SMTP server; ports 465 / 2465 = SSL, 587 / 2587 = STARTTLS.
# Resend: TPM_SMTP_HOST=smtp.resend.com, TPM_SMTP_PORT=465, TPM_SMTP_USER=resend, TPM_SMTP_PASSWORD=<Resend API key re_...>,
# TPM_SMTP_FROM=onboarding@resend.dev (delivers only to your Resend account's address until you verify a domain)
TPM_SMTP_HOST=
TPM_SMTP_PORT=587
TPM_SMTP_USER=
TPM_SMTP_PASSWORD=
TPM_SMTP_FROM=
